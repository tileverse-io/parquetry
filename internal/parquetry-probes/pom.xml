<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.tileverse.parquetry</groupId>
    <artifactId>parquetry-internal</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>parquetry-probes</artifactId>
  <name>Parquetry :: Internal :: Probes</name>
  <description>Standalone read-comparison probes (parquetry vs parquet-java vs DuckDB). Build and dev only; never
    published. Run as main() apps; the runnable uber-jar is built under the probes profile and driven by
    run-probe-docker.sh.</description>

  <properties>
    <!--
      The probes compare against parquet-java (parquet-hadoop) and DuckDB, whose transitive Hadoop stack does not
      converge. Convergence is irrelevant for a non-published, shaded dev tool; the enforcer is skipped here. The
      benchmarks module keeps these deps at test scope for the same reason; this module needs them at compile scope.
    -->
    <enforcer.skip>true</enforcer.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The multi-file concurrent-read probe opens a ParquetSource over a FilesetReader (io.tileverse.parquetry.dataset). -->
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-catalog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Reads fixtures over tileverse-storage (HTTP/S3/...) when parquetry.probe.url is set, letting a
         latency-injecting file server stand in for object storage. Transitively brings tileverse-storage-all. -->
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-tileverse-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-hadoop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>3.3.6</version>
      <exclusions>
        <!-- Hadoop's older Jackson shadows the Jackson 3 parquetry's GeoParquet parser needs; keep ours. -->
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- parquet-java's ParquetReader.Builder transitively loads FileInputFormat, which hadoop-common alone lacks. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-mapreduce-client-core</artifactId>
      <version>3.3.6</version>
      <exclusions>
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
    </dependency>
    <!-- DuckDB's columnar arm streams results as Arrow batches (DuckDBResultSet.arrowExportStream over the C Data
         Interface): arrow-vector for the vectors, arrow-c-data for the stream bridge, arrow-memory-unsafe for the
         off-heap allocator. -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-c-data</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-unsafe</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- An SLF4J binding for the Hadoop/parquet-java stack; without one they log the NOP-provider warning. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- Builds the runnable uber-jar (target/probes.jar). Kept out of the default build because it shades the
           Hadoop stack; build it explicitly: ./mvnw -Pprobes -pl :parquetry-probes -am package -->
      <id>probes</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <goals>
                  <goal>shade</goal>
                </goals>
                <phase>package</phase>
                <configuration>
                  <finalName>probes</finalName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <transformers>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>io.tileverse.parquetry.probes.ProbeMain</mainClass>
                    </transformer>
                    <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  </transformers>
                  <filters>
                    <filter>
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
