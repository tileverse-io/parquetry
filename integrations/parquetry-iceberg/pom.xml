<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.tileverse.parquetry</groupId>
    <artifactId>parquetry-integrations</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>parquetry-iceberg</artifactId>
  <name>Parquetry :: Integrations :: Iceberg</name>
  <description>Apache Iceberg table reader: resolves a table from its metadata, reads the manifest list and manifests with
    the clean-room Avro reader, and reads data files with the core Parquet reader. No dependency on iceberg-core,
    apache-avro, or Hadoop.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-catalog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-avro</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Vendored iceberg-geo-testbed goldens + the classpath extractor; reactor-only. -->
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
