<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.tileverse.parquetry</groupId>
    <artifactId>parquetry-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>parquetry-core</artifactId>
  <name>Parquetry :: Core</name>
  <description>Schema model, codecs, decoders, filter pushdown, single-file reader and writer.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-io</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The shared recording ByteRangeSource and latency model that read byte assertions build on. -->
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-io</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-compression</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-format</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Direct aircompressor use in core is the bloom-filter XxHash64 and the CompressionTest fixtures;
         the compression codecs themselves live in parquetry-compression. -->
    <dependency>
      <groupId>io.airlift</groupId>
      <artifactId>aircompressor-v3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Retained for the read/write tests that build or read fixtures through AvroParquetReader/AvroParquetWriter
      (ParquetDatasetTest, EndToEndV2ReadTest, the V1 conformance and write-bridge tests, and others). The corpus
      conformance test no longer uses it; ParquetTestingCorpusIT reads the oracle through parquet-java SimpleGroup.
    -->
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-avro</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>3.3.6</version>
      <scope>test</scope>
    </dependency>
    <!--
      Required by the V1 fixture conformance test (DataPageV1ConformanceTest): AvroParquetReader's builder
      transitively touches ParquetInputFormat.getFilter during construction, which loads
      org.apache.hadoop.mapreduce.lib.input.FileInputFormat. hadoop-common alone does not pull this in.
    -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-mapreduce-client-core</artifactId>
      <version>3.3.6</version>
      <scope>test</scope>
    </dependency>
    <!--
      Required by the parquet-java oracle: its reader decompresses hadoop_lz4_compressed* fixtures via lz4-java's
      LZ4Factory at runtime. Test-scope only.
    -->
    <dependency>
      <groupId>org.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.8.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.locationtech.jts</groupId>
      <artifactId>jts-core</artifactId>
    </dependency>
    <!-- Bundled test corpora (apache/parquet-testing) + the classpath extractor; reactor-only, never published. -->
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
        <includes>
          <include>io/tileverse/parquetry/build.properties</include>
        </includes>
      </resource>
      <resource>
        <filtering>false</filtering>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>io/tileverse/parquetry/build.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
