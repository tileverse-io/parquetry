<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.tileverse.parquetry</groupId>
    <artifactId>parquetry-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>parquetry-io</artifactId>
  <name>Parquetry :: IO</name>
  <description>Positional byte-range source and pooled native-segment SPIs, with the adapter onto tileverse-storage range readers.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The RangeReader adapted by ByteRangeSource.of and ByteRangeSource.owning. Managed by the tileverse BOM
         through parquetry-dependencies. -->
    <dependency>
      <groupId>io.tileverse.storage</groupId>
      <artifactId>tileverse-storage-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
