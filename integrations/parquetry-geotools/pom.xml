<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.tileverse.parquetry</groupId>
    <artifactId>parquetry-integrations</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>parquetry-geotools</artifactId>
  <name>Parquetry :: Integrations :: GeoTools</name>
  <description>Read-only GeoTools DataStore for GeoParquet, backed by the parquetry dataset catalog.</description>

  <properties>
    <gt.version>35.0</gt.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-dependencies</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-catalog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-tileverse-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-stac</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-iceberg</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-main</artifactId>
      <version>${gt.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-epsg-hsql</artifactId>
      <version>${gt.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-cql</artifactId>
      <version>${gt.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The parquetry writer is flat-only; DuckDB writes the nested GeoParquet test fixtures. -->
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.tileverse.parquetry</groupId>
      <artifactId>parquetry-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <!-- GeoTools 35.0 is published to the OSGeo release repo, not Maven Central. -->
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>osgeo-release</id>
      <name>OSGeo Release Repository</name>
      <url>https://repo.osgeo.org/repository/release/</url>
    </repository>
    <!-- Keep the OSGeo snapshot repo for development builds against GeoTools snapshots. -->
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>osgeo-snapshot</id>
      <name>OSGeo Snapshot Repository</name>
      <url>https://repo.osgeo.org/repository/snapshot/</url>
    </repository>
  </repositories>

  <profiles>
    <profile>
      <!--
        Converges the GeoTools provided tree for the enforcer dependencyConvergence rule. Overrides live here,
        mirroring the root POM, and are only paid when convergence is actually being checked. Active by default;
        opt out with -DskipDependencyConvergence.
      -->
      <id>dependencyConvergence</id>
      <activation>
        <activeByDefault>false</activeByDefault>
        <property>
          <name>!skipDependencyConvergence</name>
        </property>
      </activation>
      <dependencyManagement>
        <dependencies>
          <!-- gt-main brings two versions of commons-lang3 transitively; pin to the higher one. -->
          <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
          </dependency>
          <!-- gt-main pulls javax.measure:unit-api 2.1.2 (via systems.uom) and 2.2 (via indriya); pin to 2.2. -->
          <dependency>
            <groupId>javax.measure</groupId>
            <artifactId>unit-api</artifactId>
            <version>2.2</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
  </profiles>
</project>
