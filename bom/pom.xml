<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.tileverse.parquetry</groupId>
    <artifactId>parquetry-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>parquetry-bom</artifactId>
  <packaging>pom</packaging>
  <name>Parquetry :: BOM</name>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-io</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-compression</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-format</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-avro</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-catalog</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-encryption</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-arrow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-tileverse-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-stac</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-iceberg</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.tileverse.parquetry</groupId>
        <artifactId>parquetry-geotools</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <plugin>
        <!--
        flatten plugin configured to install a BOM pom, though not using flattenMode=bom because it doesn't resolve
        version properties and adds properties defined in the root pom.
        See https://www.mojohaus.org/flatten-maven-plugin/flatten-mojo.html#flattenMode
        -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>ossrh</flattenMode>
          <pomElements>
            <!--
            Take the entries declared in this pom, with the version placeholders resolved against the properties
            inherited from the root pom. Keeps the root pom's own managed dependencies out of the published BOM.
            -->
            <dependencyManagement>extended_interpolate</dependencyManagement>
            <!--
            Keep any dependencies inherited from the root pom out of the published BOM.
            A BOM must not add dependencies to its consumers.
            -->
            <dependencies>remove</dependencies>
          </pomElements>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
